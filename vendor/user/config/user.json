{
    "user/model": {
        "entities": {
            "user": { "table": "user" }
        },
        "properties": {
            "id": { "entity": "user", "column": "id", "type": "int" },
            "status": { "entity": "user", "column": "status", "audit": true },
            "n_fn": { "entity": "user", "column": "n_fn", "audit": true },
            "email": { "entity": "user", "column": "email", "audit": true },
            "locale": { "entity": "user", "column": "locale", "audit": true },
            "password": { "entity": "user", "column": "password" },
            "password_token_hash": { "entity": "user", "column": "password_token_hash" },
            "refresh_token_expires_at": { "entity": "user", "column": "refresh_token_expires_at", "type": "datetime" },
            "last_login": { "entity": "user", "column": "last_login", "type": "datetime" },
            "last_updated": { "entity": "user", "column": "last_updated", "type": "datetime" },
            "login_failed": { "entity": "user", "column": "login_failed", "type": "int" },
            "touched_at": { "entity": "user", "column": "touched_at", "type": "datetime" },
            "touched_by": { "entity": "user", "column": "touched_by", "type": "int" },
            "creation_time": {},
            "creation_user": {},
            "update_user": {}
        }
    },

    "user/password": {
        "rule": "/^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*?[@.#$!%*?&])[A-Za-z\\d@.#$!%*?&]{12,64}$/",
        "ruleText": { 
            "default": "The password should contain between 8 and 64 characters mixing lowercases, uppercases, digits and special characters. Allowed special characters are: @ . # $ ! % * ? &", 
            "fr_FR": "Le mot de passe doit contenir entre 8 et 64 caractères mélangeant minuscules, majuscules, chiffres et caractères spéciaux. Les caractères spéciaux autorisés sont : @ . # $ ! % * ? &"
        }
    }
}